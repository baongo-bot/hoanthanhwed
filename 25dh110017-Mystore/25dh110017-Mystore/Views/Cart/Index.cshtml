@model _25dh110017_Mystore.Models.Cart.Cart

@{
    ViewBag.Title = "Giỏ hàng của bạn - ARIS SHOP";
}

<div class="container my-5" style="max-width: 1100px;">
    <div class="card bg-dark text-light p-4 shadow-lg cyber-panel" style="border: 1px solid rgba(0, 242, 254, 0.3); border-radius: 12px; background-color: #0b0f19 !important;">
        <h2 class="text-info font-weight-bold mb-4 text-center" style="text-shadow: 0 0 10px rgba(0, 242, 254, 0.5);">
            🛒 GIỎ HÀNG CỦA BẠN
        </h2>

        @if (Model != null && Model.Items != null && Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover table-bordered align-middle text-light mb-4" style="border-color: rgba(0, 242, 254, 0.2);">
                    <thead>
                        <tr class="text-info">
                            <th class="text-center" style="width: 100px;">Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th class="text-end text-right">Đơn giá</th>
                            <th class="text-center" style="width: 160px;">Số lượng</th>
                            <th class="text-end text-right">Thành tiền</th>
                            <th class="text-center" style="width: 110px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center">
                                    <img src="@(item.product.ProductImage != null && item.product.ProductImage.StartsWith("http") ? item.product.ProductImage : Url.Content("~/Images/" + item.product.ProductImage))"
                                         alt="@item.product.ProductName"
                                         style="width: 60px; height: 60px; object-fit: cover; border: 1px solid rgba(0, 242, 254, 0.3);"
                                         class="rounded"
                                         onerror="this.src='https://picsum.photos/seed/@item.product.ProductID/60/60'" />
                                </td>
                                <td class="align-middle">
                                    <strong class="text-light">@item.product.ProductName</strong>
                                </td>
                                <td class="text-end text-right align-middle text-light font-weight-bold">
                                    @item.product.ProductPrice.ToString("N0") VNĐ
                                </td>
                                <td class="text-center align-middle">
                                    @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-flex justify-content-center align-items-center gap-1" }))
                                    {
                                        @Html.Hidden("productID", item.product.ProductID)
                                        <input type="number" name="quantity" value="@item.quantity" min="1" max="100" class="form-control form-control-sm bg-dark text-light text-center border-secondary me-1" style="width: 65px; display: inline-block;" />
                                        <button type="submit" class="btn btn-outline-info btn-sm px-2" title="Cập nhật">↻</button>
                                    }
                                </td>
                                <td class="text-end text-right align-middle text-danger font-weight-bold" style="text-shadow: 0 0 5px rgba(244, 63, 94, 0.3);">
                                    <strong>@item.TotalPrice.ToString("N0") VNĐ</strong>
                                </td>
                                <td class="text-center align-middle">
                                    <a href="@Url.Action("RemoveFromCart", "Cart", new { productID = item.product.ProductID })"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?');">
                                        Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="background-color: #111827;">
                            <td colspan="4" class="text-end text-right align-middle">
                                <h4 class="m-0 text-light" style="font-size: 18px;"><strong>Tổng tiền thanh toán:</strong></h4>
                            </td>
                            <td class="text-end text-right align-middle">
                                <h4 class="text-danger m-0" style="font-size: 18px; text-shadow: 0 0 8px rgba(244, 63, 94, 0.4);">
                                    <strong>@Model.TotalValue().ToString("N0") VNĐ</strong>
                                </h4>
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="row mt-4 mb-3">
                <div class="col-md-6 col-6">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light btn-lg">
                        ← Tiếp tục mua hàng
                    </a>
                </div>
                <div class="col-md-6 col-6 text-end text-right">
                    <a href="@Url.Action("Checkout", "Order")" class="btn btn-info btn-lg fw-bold" style="background: linear-gradient(135deg, #00f2fe 0%, #3b82f6 100%); border: none; color: #05070e;">
                        Tiến hành thanh toán →
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="alert text-center py-5 cyber-panel text-light" style="background-color: #111827 !important; border: 1px solid rgba(0, 242, 254, 0.3);">
                <h3 class="text-info mb-3">Giỏ hàng của bạn đang trống!</h3>
                <p class="text-muted">Hãy chọn thêm sản phẩm vào giỏ hàng để tiến hành mua sắm nhé.</p>
                <br />
                <a href="@Url.Action("Index", "Home")" class="btn btn-info btn-lg fw-bold" style="background: linear-gradient(135deg, #00f2fe 0%, #3b82f6 100%); border: none; color: #05070e;">
                    Khám phá sản phẩm ngay
                </a>
            </div>
        }
    </div>
</div>

<style>
    .cyber-panel {
        background-color: #0b0f19 !important;
        box-shadow: 0 0 20px rgba(0, 242, 254, 0.1);
    }

    .table-dark td, .table-dark th {
        color: #f8fafc !important;
        border-color: rgba(0, 242, 254, 0.2) !important;
    }
</style>