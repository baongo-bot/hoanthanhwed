@model IEnumerable<_25dh110017_Mystore.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi - ARIS SHOP";
}

<div class="container my-5" style="max-width: 1000px;">
    <div class="card bg-dark text-light p-4 shadow-lg cyber-panel" style="border: 1px solid rgba(0, 242, 254, 0.3); border-radius: 12px; background-color: #0b0f19 !important;">
        <h2 class="text-info font-weight-bold mb-4 text-center" style="text-shadow: 0 0 10px rgba(0, 242, 254, 0.5);">
            📋 LỊCH SỬ ĐƠN HÀNG CỦA TÔI
        </h2>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover table-bordered align-middle text-light mb-4" style="border-color: rgba(0, 242, 254, 0.2);">
                    <thead>
                        <tr class="text-info">
                            <th class="text-center" style="width: 100px;">Mã ĐH</th>
                            <th>Ngày đặt hàng</th>
                            <th class="text-end text-right">Tổng tiền</th>
                            <th>Địa chỉ nhận hàng</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center" style="width: 130px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">#@item.OrderID</td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end text-right text-danger fw-bold" style="text-shadow: 0 0 5px rgba(244, 63, 94, 0.3);">
                                    @string.Format("{0:N0} VNĐ", item.TotalAmount)
                                </td>
                                <td>@item.AddressDelivery</td>
                                <td class="text-center">
                                    @if (item.PaymentStatus == "Đang xử lý" || item.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Đang xử lý</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@item.PaymentStatus</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("OrderSuccess", "Order", new { id = item.OrderID })" class="btn btn-sm btn-outline-info">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert text-center py-5 cyber-panel text-light" style="background-color: #111827 !important; border: 1px solid rgba(0, 242, 254, 0.3);">
                <h4 class="text-info mb-3">Bạn chưa có đơn hàng nào trong lịch sử.</h4>
                <p class="text-muted">Hãy tiến hành mua sắm để trải nghiệm dịch vụ của ARIS SHOP nhé.</p>
                <br />
                <a href="@Url.Action("Index", "Home")" class="btn btn-info btn-lg fw-bold px-4 py-2" style="background: linear-gradient(135deg, #00f2fe 0%, #3b82f6 100%); border: none; color: #05070e;">
                    🛒 Mua sắm ngay
                </a>
            </div>
        }

        <div class="mt-3 pt-3 border-top border-secondary">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light btn-sm">← Về trang chủ</a>
        </div>
    </div>
</div>

<style>
    .cyber-panel {
        background-color: #0b0f19 !important;
        box-shadow: 0 0 20px rgba(0, 242, 254, 0.1);
    }

    .table-dark td, .table-dark th {
        color: #f8fafc !important;
        border-color: rgba(0, 242, 254, 0.2) !important;
    }
</style>