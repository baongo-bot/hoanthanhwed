@model _25dh110017_Mystore.Models.ViewModel.RegisterVM
@{ ViewBag.Title = "Đăng ký tài khoản"; }

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-success text-white text-center py-3">
                    <h4 class="mb-0">TẠO TÀI KHOẢN MỚI</h4>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @* Hiển thị tổng hợp các thông báo lỗi từ Model và CSDL *@
                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger mb-3 p-2 small" })

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Username, new { @class = "form-label font-weight-bold" })
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Nhập tên đăng nhập..." })
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.Password, new { @class = "form-label font-weight-bold" })
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu..." })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label font-weight-bold" })
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu..." })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.CustomerName, new { @class = "form-label font-weight-bold" })
                            @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", placeholder = "Nhập họ và tên..." })
                            @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label font-weight-bold" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Nhập địa chỉ email..." })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        @* BỔ SUNG Ô NHẬP SỐ ĐIỆN THOẠI TRÁNH LỖI NOT NULL TRONG CSDL *@
                        <div class="form-group mb-4">
                            @Html.LabelFor(m => m.Phone, new { @class = "form-label font-weight-bold" })
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "Nhập số điện thoại..." })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 font-weight-bold mb-3">ĐĂNG KÝ</button>

                        <div class="text-center">
                            Đã có tài khoản? @Html.ActionLink("Đăng nhập tại đây", "Login", "Account")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>