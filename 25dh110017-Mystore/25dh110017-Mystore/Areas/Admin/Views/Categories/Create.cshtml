@model _25dh110017_Mystore.Models.Category

<div class="form-group mb-3">
    @Html.LabelFor(model => model.CategoryName, "Tên danh mục", htmlAttributes: new { @class = "control-label col-md-2 text-secondary fw-bold" })
    <div class="col-md-10">
        @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control bg-dark text-light border-secondary" } })
        @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group mt-3">
    <div class="col-md-offset-2 col-md-10">
        <button type="submit" class="btn btn-success px-4 me-2">Lưu lại</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Quay lại danh sách</a>
    </div>
</div>