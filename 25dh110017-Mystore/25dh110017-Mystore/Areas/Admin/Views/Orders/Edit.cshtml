@model _25dh110017_Mystore.Models.Order

@{
    ViewBag.Title = "Chỉnh sửa đơn hàng #" + Model.OrderID;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid my-4" style="max-width: 800px;">
    <h2 class="text-info font-weight-bold mb-4">✏️ Chỉnh sửa Đơn hàng #@Model.OrderID</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="card bg-dark text-light p-4 shadow-lg" style="border: 1px solid rgba(0, 242, 254, 0.3); background-color: #0b0f19 !important;">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.OrderID)
            @Html.HiddenFor(model => model.CustomerID)
            @Html.HiddenFor(model => model.OrderDate)
            @Html.HiddenFor(model => model.TotalAmount)

            <div class="mb-3">
                <label class="form-label text-light">Khách hàng</label>
                <input type="text" class="form-control bg-dark text-light border-secondary" value="@(Model.Customer != null ? Model.Customer.CustomerName : "N/A")" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label text-light">Ngày đặt hàng</label>
                <input type="text" class="form-control bg-dark text-light border-secondary" value="@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label text-light">Tổng tiền</label>
                <input type="text" class="form-control bg-dark text-danger font-weight-bold border-secondary" value="@string.Format("{0:N0} VNĐ", Model.TotalAmount)" readonly />
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.AddressDelivery, "Địa chỉ giao hàng", htmlAttributes: new { @class = "form-label text-light" })
                @Html.EditorFor(model => model.AddressDelivery, new { htmlAttributes = new { @class = "form-control bg-dark text-light border-secondary" } })
                @Html.ValidationMessageFor(model => model.AddressDelivery, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.PaymentStatus, "Trạng thái thanh toán", htmlAttributes: new { @class = "form-label text-light" })
                @Html.DropDownListFor(model => model.PaymentStatus, new SelectList(new[] { "Pending", "Completed", "Cancelled" }, Model.PaymentStatus), new { @class = "form-select bg-dark text-light border-secondary" })
                @Html.ValidationMessageFor(model => model.PaymentStatus, "", new { @class = "text-danger small" })
            </div>

            <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-between">
                @Html.ActionLink("← Quay lại", "Index", null, new { @class = "btn btn-outline-light btn-sm" })
                <input type="submit" value="Lưu thay đổi" class="btn btn-info font-weight-bold px-4" style="background: linear-gradient(135deg, #00f2fe 0%, #3b82f6 100%); border: none; color: #05070e;" />
            </div>
        </div>
    }
</div>