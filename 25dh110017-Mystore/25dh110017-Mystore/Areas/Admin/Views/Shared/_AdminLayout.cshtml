<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị ARIS SHOP</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        /* Tùy chỉnh phong cách Cyberpunk cao cấp cho Admin Navbar */
        .navbar-brand {
            color: #00f2fe !important;
            font-weight: bold;
            text-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
            letter-spacing: 1px;
        }

        .navbar-nav .nav-link {
            color: #a0aec0 !important;
            padding: 8px 15px;
            transition: all 0.3s ease;
            border-radius: 4px;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-link.active {
                color: #00f2fe !important;
                background-color: rgba(0, 242, 254, 0.1);
                text-shadow: 0 0 8px rgba(0, 242, 254, 0.4);
            }

        /* Panel quản trị phong cách tối */
        .admin-panel {
            background-color: #0b0f19 !important;
            border: 1px solid rgba(0, 242, 254, 0.2);
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.05);
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-dark text-light">
    <!-- THANH ĐIỀU HƯỚNG ADMIN -->
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark py-2 border-bottom border-secondary" style="border-color: rgba(0, 242, 254, 0.2) !important;">
        <div class="container-fluid px-4">
            <!-- Thương hiệu website quản trị -->
            @Html.ActionLink("⚡ ARIS ADMIN", "Index", "Products", new { area = "Admin" }, new { @class = "navbar-brand" })

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <!-- Danh mục quản lý chính -->
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">@Html.ActionLink("Trang chủ", "Index", "Home", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Danh mục", "Index", "Categories", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Sản phẩm", "Index", "Products", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Khách hàng", "Index", "Customers", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "Admin" }, new { @class = "nav-link text-warning fw-bold" })</li>
                </ul>

                <!-- Nút phụ trợ quay về web khách hàng -->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        @Html.ActionLink("🌐 Xem Website", "Index", "Home", new { area = "" }, new { @class = "btn btn-outline-info btn-sm" })
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG CHÍNH TỰ ĐỘNG GIÃN NỞ -->
    <div class="container body-content my-4 flex-grow-1">
        @RenderBody()
    </div>

    <!-- CHÂN TRANG (STICKY FOOTER) -->
    <footer class="text-center py-3 mt-auto border-top border-secondary bg-dark text-muted" style="border-color: rgba(0, 242, 254, 0.2) !important; font-size: 13px;">
        <div class="container">
            <p class="mb-0">&copy; @DateTime.Now.Year - ARIS SHOP Management System (Admin Panel)</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>